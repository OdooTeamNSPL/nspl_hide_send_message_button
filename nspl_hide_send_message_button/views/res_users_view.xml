<odoo>
    <record id="view_users_form_inherit_hide_send" model="ir.ui.view">
        <field name="name">res.users.form.inherit.hide.send</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signature']" position="before">
                <field name="hide_send_message_button"/>
            </xpath>
        </field>
    </record>
</odoo>
